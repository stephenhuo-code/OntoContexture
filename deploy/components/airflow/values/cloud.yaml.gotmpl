# 云端（030 research R6）：块存储只支持 RWO，Airflow 全部 Pod（含 KubernetesExecutor 任务 Pod，Chart 1.22.0 的
# pod-template-file 取全局 affinity / nodeSelector）以 Pod 亲和固定到调度器所在节点，共享 dags 卷；只调度到弹性池
images:
  airflow:
    repository: {{ .Values.registry }}/openmetadata-ingestion-airflow
  pod_template:
    repository: {{ .Values.registry }}/openmetadata-ingestion-airflow
registry:
  secretName: docr-pull
nodeSelector:
  {{ .Values.nodeLabel }}: {{ .Values.nodePool | quote }}
affinity:
  podAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - labelSelector:
          matchLabels: { component: scheduler, release: airflow }
        topologyKey: kubernetes.io/hostname
  # 独占节点（T052 实测）：Airflow 常驻 Pod 与采集任务 Pod 须同节点，若与其他组件混放，调度器所在节点满载后其余 Pod 无法调度，
  # 集群扩容也无济于事。必需反亲和是对称的：Airflow 不进有其他组件的节点，其他组件也不进 Airflow 所在节点。
  # 本 namespace 中只有 Airflow 带 release 标签；OTel 采集代理是 DaemonSet，须排除。
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - labelSelector:
          matchExpressions:
            - { key: release, operator: NotIn, values: [airflow] }
            - { key: component, operator: NotIn, values: [agent-collector] }
        topologyKey: kubernetes.io/hostname
dags:
  persistence:
    storageClassName: {{ .Values.storageClass }}
triggerer:
  persistence:
    storageClassName: {{ .Values.storageClass }}
