{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ctx:schema:error:v1",
  "title": "ErrorEnvelope",
  "type": "object",
  "required": ["code", "message", "trace_id"],
  "properties": {
    "code": {
      "type": "string",
      "description": "稳定的机器可读错误码，如 auth.invalid_token、auth.invalid_audience、authz.denied、upstream.unavailable",
      "pattern": "^[a-z]+(\\.[a-z_]+)+$"
    },
    "message": { "type": "string", "description": "面向人的说明" },
    "trace_id": { "type": "string", "description": "当前请求的 OTel trace id" },
    "details": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
