# 云端（DOKS）配置模板（030）。复制为 .env.cloud 后填写；.env.cloud 已被 .gitignore 忽略，切勿提交。
# 键与校验规则见 specs/030-doks-deploy/contracts/cloud-config.md。

# 集群访问：kubeconfig 权限须为 600；上下文名可用 kubectl --kubeconfig <文件> config get-contexts 查看
CTX_CLOUD_KUBECONFIG=~/.kube/doks.yaml
CTX_CLOUD_CONTEXT=
# 平台 namespace（默认 contexture）
# CTX_CLOUD_NAMESPACE=contexture

# 节点池：织境负载只调度到弹性池（DOKS 的节点池标签键如下；池名见 doctl kubernetes cluster node-pool list <集群>）
CTX_CLOUD_NODE_LABEL=doks.digitalocean.com/node-pool
CTX_CLOUD_NODE_POOL=
# 存储类（DOKS 默认 do-block-storage）
CTX_CLOUD_STORAGE_CLASS=do-block-storage

# 对外域名：<域名> 与 *.<域名> 两条 A 记录指向负载均衡器 IP（cloud-deploy 会输出）
CTX_CLOUD_DOMAIN=
# Let's Encrypt 联系邮箱；签发器 staging | production（默认 production，首次可先用 staging 验通）
CTX_CLOUD_ACME_EMAIL=
# CTX_CLOUD_ACME_SERVER=staging

# 镜像仓库（DOCR）：registry.digitalocean.com/<名称>；只读令牌用于集群拉取，读写令牌用于集群内构建
CTX_CLOUD_REGISTRY=
CTX_CLOUD_REGISTRY_READ_TOKEN=
CTX_CLOUD_REGISTRY_WRITE_TOKEN=

# 模型服务（AI 网关的模型路由，与 .env.local 相同；未配置时为占位）
# MODEL_HOST=
# MODEL_NAME=
# MODEL_API_KEY=
